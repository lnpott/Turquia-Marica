# Desligado por padrão. Use somente em desenvolvimento/QA local.
# Nunca configure esta variável no deploy público canônico.
VITE_VISUAL_QA_DEMO=false

# --- Supabase (público no client, protegido por RLS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase server-only (NUNCA prefixar com VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin API /api/admin e painel /admin (server-only) ---
ADMIN_TOKEN=

# Variáveis exclusivamente server-side usadas pela função /api/reviews.
# Configure os valores reais somente no ambiente seguro do servidor/Vercel.
GOOGLE_PLACE_ID=
GOOGLE_MAPS_API_KEY=
