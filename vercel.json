{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/cardapio", "destination": "/cardapio/index.html" },
    { "source": "/localizacao", "destination": "/localizacao/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
