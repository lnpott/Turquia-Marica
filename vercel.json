{
  "cleanUrls": true,
  "redirects": [
    { "source": "/cardapio", "destination": "/#cardapio", "permanent": true },
    { "source": "/localizacao", "destination": "/#localizacao", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
